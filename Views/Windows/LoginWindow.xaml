<Window x:Class="QL_JBillard.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quản lý hệ thống bida - Đăng Nhập" 
        Icon="pack://application:,,,/Resources/bida.ico"
        Height="500" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="LoginWindow_Loaded"
        Background="#F1F5F9">
    
    <Border Padding="32,24">
        <StackPanel VerticalAlignment="Center">
            <!-- Logo & Brand Header -->
            <Border Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.25" ShadowDepth="4" Color="#059669" />
                </Border.Effect>
                <Image Source="pack://application:,,,/Resources/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            
            <TextBlock Text="QUẢN LÝ HỆ THỐNG BIDA" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Hệ Thống Vận Hành &amp; Quản Lý Câu Lạc Bộ Chuyên Nghiệp" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,22" />

            <!-- Card Đăng Nhập Sáng Sang Trọng -->
            <Border Background="#FFFFFF" CornerRadius="12" Padding="26" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.08" ShadowDepth="6" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <!-- Username -->
                    <TextBlock Text="TÊN ĐĂNG NHẬP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="TxtUsername" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                             Height="42" Margin="0,0,0,14" Foreground="#000000" CaretBrush="#000000" FontWeight="SemiBold" FontSize="14" 
                             VerticalContentAlignment="Center" Padding="12,0" />

                    <!-- Password -->
                    <TextBlock Text="MẬT KHẨU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="TxtPassword" PasswordChar="●" 
                                 Height="42" Margin="0,0,0,16" PasswordChanged="TxtPassword_PasswordChanged" 
                                 Foreground="#000000" CaretBrush="#000000" FontWeight="SemiBold" FontSize="14" 
                                 VerticalContentAlignment="Center" Padding="12,0" />

                    <!-- Thông báo lỗi nếu có -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentCrimsonBrush}" 
                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}" />

                    <!-- Button Đăng Nhập -->
                    <Button Content="ĐĂNG NHẬP HỆ THỐNG" Style="{StaticResource PrimaryButton}" 
                            Height="42" IsDefault="True" Command="{Binding LoginCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
