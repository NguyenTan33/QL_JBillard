<UserControl x:Class="QL_JBillard.Views.UserControls.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: DANH SÁCH TÀI KHOẢN -->
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="18" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Thanh Tìm Kiếm & Nút Thêm Mới -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0">
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10,0" VerticalContentAlignment="Center" Height="36" FontSize="13" 
                                 Foreground="#000000" CaretBrush="#000000" FontWeight="SemiBold" />
                        <TextBlock Text="🔍 Tìm kiếm theo tên hoặc tài khoản..." Foreground="{StaticResource TextMutedBrush}" 
                                   Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchKeyword, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}" />
                    </Grid>

                    <Button Grid.Column="2" Content="Làm Mới" Style="{StaticResource SecondaryButton}" Command="{Binding LoadUsersCommand}" Height="36" />
                </Grid>

                <!-- DataGrid Danh sách người dùng -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" 
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                          BorderBrush="{StaticResource BorderDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TÊN ĐĂNG NHẬP" Binding="{Binding Username}" Width="140" FontWeight="Bold" />
                        <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="SỐ ĐIỆN THOẠI" Binding="{Binding PhoneNumber}" Width="120" />
                        
                        <DataGridTemplateColumn Header="VAI TRÒ" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Role, Converter={StaticResource RoleToTextConverter}}" 
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#ECFDF5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#FFF1F2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="● Đang Hoạt Động" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentEmeraldDarkBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="🔒 Đã Khóa" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentCrimsonBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="THAO TÁC" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Sửa" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0"
                                            Command="{Binding DataContext.SelectUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- CỘT PHẢI: FORM TẠO & QUẢN LÝ TÀI KHOẢN -->
        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="👤 TẠO TÀI KHOẢN THU NGÂN MỚI" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="👤 CẬP NHẬT TÀI KHOẢN" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Tên đăng nhập -->
                    <TextBlock Text="TÊN ĐĂNG NHẬP (*)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditing}" 
                             Height="36" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,12" 
                             Foreground="#000000" CaretBrush="#000000" FontWeight="SemiBold" />

                    <!-- Họ và tên -->
                    <TextBlock Text="HỌ VÀ TÊN NHÂN VIÊN (*)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}" 
                             Height="36" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,12" 
                             Foreground="#000000" CaretBrush="#000000" FontWeight="SemiBold" />

                    <!-- Số điện thoại -->
                    <TextBlock Text="SỐ ĐIỆN THOẠI LIÊN HỆ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" 
                             Height="36" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,12" 
                             Foreground="#000000" CaretBrush="#000000" FontWeight="SemiBold" />

                    <!-- Vai trò -->
                    <TextBlock Text="VAI TRÒ TRONG HỆ THỐNG (*)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding FormRole}" Height="36" Margin="0,0,0,12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource RoleToTextConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Mật khẩu -->
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="MẬT KHẨU (*)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="MẬT KHẨU MỚI (Bỏ trống nếu không đổi)" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding FormPassword, UpdateSourceTrigger=PropertyChanged}" 
                             Height="36" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,14" 
                             Foreground="#000000" CaretBrush="#000000" FontWeight="SemiBold" />

                    <!-- Trạng thái kích hoạt -->
                    <CheckBox IsChecked="{Binding FormIsActive}" Content="Kích hoạt tài khoản này (Cho phép đăng nhập)" 
                              FontWeight="SemiBold" Margin="0,0,0,16" />

                    <!-- Thông báo trạng thái -->
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource AccentEmeraldDarkBrush}" 
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <!-- Các nút hành động -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy" Style="{StaticResource SecondaryButton}" 
                                Height="38" Command="{Binding NewUserCommand}" />
                        <Button Grid.Column="2" Content="✓ LƯU TÀI KHOẢN" Style="{StaticResource PrimaryButton}" 
                                Height="38" Command="{Binding SaveUserCommand}" />
                    </Grid>

                    <!-- Nút Khóa / Xóa khi đang sửa -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}">
                        <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Khóa / Mở Khóa" Style="{StaticResource SecondaryButton}" Height="34" 
                                    Command="{Binding ToggleStatusCommand}" />
                            <Button Grid.Column="2" Content="Xóa Tài Khoản" Style="{StaticResource DangerButton}" Height="34" 
                                    Command="{Binding DeleteUserCommand}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
