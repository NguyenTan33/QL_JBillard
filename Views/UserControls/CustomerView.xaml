<UserControl x:Class="QL_JBillard.Views.UserControls.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Cột Trái: Danh Sách Khách Hàng -->
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="8,6" Height="36" FontSize="13" />
                        <TextBlock Text="🔍 Tìm kiếm theo số điện thoại hoặc tên khách..." Foreground="{StaticResource TextMutedBrush}" 
                                   Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchKeyword, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}" />
                    </Grid>
                    
                    <Button Grid.Column="1" Content="Làm Mới" Style="{StaticResource SecondaryButton}" Command="{Binding LoadDataCommand}" Height="36" />
                </Grid>

                <!-- DataGrid (Màu sáng) -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Customers}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True"
                          Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                          BorderBrush="{StaticResource BorderDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SỐ ĐIỆN THOẠI" Binding="{Binding PhoneNumber}" Width="130" />
                        <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="HẠNG THÀNH VIÊN" Binding="{Binding Tier.TierName}" Width="130" />
                        <DataGridTextColumn Header="ĐIỂM TÍCH LŨY" Binding="{Binding CurrentPoints, StringFormat='{}{0:N0} đ'}" Width="110" />
                        <DataGridTextColumn Header="TỔNG CHI TIÊU" Binding="{Binding TotalSpent, Converter={StaticResource CurrencyConverter}}" Width="130" />
                        <DataGridTextColumn Header="LẦN CHƠI GẦN NHẤT" Binding="{Binding LastVisitAt, StringFormat='{}{0:dd/MM/yyyy}'}" Width="130" />

                        <!-- Cột Thao Tác (Chỉ Admin mới có quyền Sửa hoặc Xóa/Khóa hội viên) -->
                        <DataGridTemplateColumn Header="THAO TÁC" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- Dành cho Admin: nút Sửa & Xóa -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}">
                                            <Button Content="Sửa" Style="{StaticResource SecondaryButton}" Padding="8,2" Height="26" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Xóa" Style="{StaticResource DangerButton}" Padding="8,2" Height="26"
                                                    Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <!-- Dành cho Thu ngân: Khóa sửa/xóa, chỉ tra cứu & tích điểm -->
                                        <TextBlock Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#94A3B8"
                                                   Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Cột Phải: Thêm / Cập Nhật Khách Hàng -->
        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Padding="18" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" Margin="0,0,0,16" />

                <TextBlock Text="SỐ ĐIỆN THOẠI (*)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,14" />

                <TextBlock Text="HỌ VÀ TÊN (*)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,14" />

                <TextBlock Text="GHI CHÚ / SỞ THÍCH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" Margin="0,0,0,14" />

                <!-- Thông báo trạng thái -->
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource AccentEmeraldDarkBrush}" 
                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="LƯU THÔNG TIN" Style="{StaticResource PrimaryButton}" Height="38" 
                            Command="{Binding SaveCustomerCommand}" />

                    <Button Grid.Column="1" Content="Hủy" Style="{StaticResource SecondaryButton}" Height="38" Margin="8,0,0,0" Padding="14,0"
                            Visibility="{Binding IsEditingCustomer, Converter={StaticResource BoolToVisConverter}}"
                            Command="{Binding CancelEditCustomerCommand}" />
                </Grid>

                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="🎁 Chính sách tích điểm &amp; Ưu đãi:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" />
                        <TextBlock Text="• 10,000 đ chi tiêu = Tích 1 điểm" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="• 1 điểm = Trừ 1,000 đ vào hóa đơn" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        <TextBlock Text="• Tự động nâng hạng: Bạc (1tr), Vàng (5tr), Kim Cương (15tr)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
