<UserControl x:Class="QL_JBillard.Views.UserControls.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dto="clr-namespace:QL_JBillard.Services.DTOs"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100"
             Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER: TIÊU ĐỀ & BỘ LỌC THỜI GIAN CHÍNH -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="📊 BÁO CÁO &amp; THỐNG KÊ DOANH THU" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Phân tích số liệu kinh doanh, hiệu suất bàn, top món F&amp;B và đối chiếu tăng trưởng" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Bộ chọn khoảng thời gian nhanh (Segmented buttons) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton Content="Hôm Nay" GroupName="PresetButtons" Style="{StaticResource SegmentedTabRadioStyle}"
                                 IsChecked="{Binding SelectedPreset, Converter={StaticResource StringEqualsConverter}, ConverterParameter=TODAY}"
                                 Command="{Binding SetPresetCommand}" CommandParameter="TODAY"
                                 Height="34" Padding="14,0" Margin="0,0,6,0" FontSize="12" />

                    <RadioButton Content="Tuần Này" GroupName="PresetButtons" Style="{StaticResource SegmentedTabRadioStyle}"
                                 IsChecked="{Binding SelectedPreset, Converter={StaticResource StringEqualsConverter}, ConverterParameter=THIS_WEEK}"
                                 Command="{Binding SetPresetCommand}" CommandParameter="THIS_WEEK"
                                 Height="34" Padding="14,0" Margin="0,0,6,0" FontSize="12" />

                    <RadioButton Content="Tháng Này" GroupName="PresetButtons" Style="{StaticResource SegmentedTabRadioStyle}"
                                 IsChecked="{Binding SelectedPreset, Converter={StaticResource StringEqualsConverter}, ConverterParameter=THIS_MONTH}"
                                 Command="{Binding SetPresetCommand}" CommandParameter="THIS_MONTH"
                                 Height="34" Padding="14,0" Margin="0,0,6,0" FontSize="12" />

                    <RadioButton Content="Tùy Chọn Ngày" GroupName="PresetButtons" Style="{StaticResource SegmentedTabRadioStyle}"
                                 IsChecked="{Binding SelectedPreset, Converter={StaticResource StringEqualsConverter}, ConverterParameter=CUSTOM}"
                                 Command="{Binding SetPresetCommand}" CommandParameter="CUSTOM"
                                 Height="34" Padding="14,0" FontSize="12" />

                    <!-- DatePicker khi chọn CUSTOM -->
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                Visibility="{Binding SelectedPreset, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=CUSTOM}">
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="125" Height="34" VerticalContentAlignment="Center" />
                        <TextBlock Text="➔" FontSize="12" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="125" Height="34" VerticalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📥 Xuất Báo Cáo Data Analyst" Style="{StaticResource PrimaryButton}"
                            Height="34" Padding="14,0" Margin="0,0,8,0" FontSize="12" FontWeight="Bold"
                            Command="{Binding ExportDetailedRevenueDataCommand}" />

                    <Button Content="🔄 Tải Lại Dữ Liệu" Style="{StaticResource SecondaryButton}"
                            Height="34" Padding="14,0" FontSize="12" FontWeight="SemiBold"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SUB-TABS: CHUYỂN ĐỔI CÁC DANH MỤC BÁO CÁO (CLEAR SEGMENTED PILLS) -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="12" Padding="8" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Direction="270" Opacity="0.04" ShadowDepth="1" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="📈 Tổng Quan &amp; Doanh Thu" GroupName="ReportSubTabs" Style="{StaticResource SegmentedTabRadioStyle}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OVERVIEW}"
                             Command="{Binding SetTabCommand}" CommandParameter="OVERVIEW"
                             Height="36" Padding="18,0" Margin="0,0,8,0" FontSize="13" />

                <RadioButton Content="🎱 Báo Cáo Theo Bàn" GroupName="ReportSubTabs" Style="{StaticResource SegmentedTabRadioStyle}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=TABLES}"
                             Command="{Binding SetTabCommand}" CommandParameter="TABLES"
                             Height="36" Padding="18,0" Margin="0,0,8,0" FontSize="13" />

                <RadioButton Content="🍔 Báo Cáo Theo Món F&amp;B" GroupName="ReportSubTabs" Style="{StaticResource SegmentedTabRadioStyle}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=PRODUCTS}"
                             Command="{Binding SetTabCommand}" CommandParameter="PRODUCTS"
                             Height="36" Padding="18,0" Margin="0,0,8,0" FontSize="13" />

                <RadioButton Content="⚖️ So Sánh Kỳ Đối Chiếu" GroupName="ReportSubTabs" Style="{StaticResource SegmentedTabRadioStyle}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=COMPARISON}"
                             Command="{Binding SetTabCommand}" CommandParameter="COMPARISON"
                             Height="36" Padding="18,0" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- 3. NỘI DUNG TỪNG TAB BÁO CÁO (ĐỘC LẬP TUYỆT ĐỐI - KHÔNG BAO GIỜ TRÙNG LẶP) -->
        <Grid Grid.Row="4">
            
            <!-- ======================================================== -->
            <!-- TAB 1: TỔNG QUAN, KPI & BIỂU ĐỒ ĐƯỜNG + BIỂU ĐỒ CỘT     -->
            <!-- ======================================================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=OVERVIEW}">
                <StackPanel>
                    <!-- 5 KPI Cards -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Tổng Doanh Thu -->
                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TỔNG DOANH THU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Overview.TotalRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Tiền Giờ Chơi -->
                        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TIỀN GIỜ CHƠI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Overview.TimeRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="17" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Tiền Món F&B -->
                        <Border Grid.Column="4" Background="#FFFFFF" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TIỀN MÓN F&amp;B" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Overview.ServiceRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="17" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Giờ Chơi Tích Lũy -->
                        <Border Grid.Column="6" Background="#FFFFFF" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TỔNG GIỜ CHƠI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Overview.TotalPlayMinutes, StringFormat='{}{0} phút'}" FontSize="17" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Tổng Hóa Đơn & Giá trị TB -->
                        <Border Grid.Column="8" Background="#FFFFFF" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TỔNG HÓA ĐƠN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Overview.TotalInvoices, StringFormat='{}{0} Bill'}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- BIỂU ĐỒ ĐƯỜNG (LINE & AREA CHART) -->
                    <Border Background="#FFFFFF" CornerRadius="12" Padding="18" Margin="0,0,0,14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📈 BIỂU ĐỒ ĐƯỜNG: XU HƯỚNG DOANH THU THEO THỜI GIAN" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Width="12" Height="12" Background="#10B981" CornerRadius="6" Margin="0,0,6,0" />
                                    <TextBlock Text="Tổng Doanh Thu (VNĐ)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Khung Canvas vẽ Polyline Line Chart kèm Trục Tọa Độ X & Y Chi Tiết -->
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="150" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="760" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Tiêu đề Trục Y -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="▲ Doanh thu" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,4" />

                                    <!-- Trục Y: Các mốc giá trị VNĐ -->
                                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                        <!-- 100% (Y=10) -->
                                        <TextBlock Text="{Binding ChartYMaxLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" />
                                        <!-- 75% (Y=45) -->
                                        <TextBlock Text="{Binding ChartY75Label}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,35,0,0" />
                                        <!-- 50% (Y=80) -->
                                        <TextBlock Text="{Binding ChartYMidLabel}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,0,0" />
                                        <!-- 25% (Y=115) -->
                                        <TextBlock Text="{Binding ChartY25Label}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,105,0,0" />
                                        <!-- 0% (Đáy) -->
                                        <TextBlock Text="{Binding ChartYZeroLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,0" />
                                    </Grid>

                                    <!-- Canvas chứa đường kẻ, diện tích, và polyline -->
                                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1,0,0,1">
                                        <Canvas Width="760" Height="150">
                                            <!-- Lưới mờ ngang -->
                                            <Line X1="0" Y1="10" X2="760" Y2="10" Stroke="#E2E8F0" StrokeDashArray="4 4" StrokeThickness="1" />
                                            <Line X1="0" Y1="45" X2="760" Y2="45" Stroke="#E2E8F0" StrokeDashArray="4 4" StrokeThickness="1" />
                                            <Line X1="0" Y1="80" X2="760" Y2="80" Stroke="#E2E8F0" StrokeDashArray="4 4" StrokeThickness="1" />
                                            <Line X1="0" Y1="115" X2="760" Y2="115" Stroke="#E2E8F0" StrokeDashArray="4 4" StrokeThickness="1" />

                                            <!-- Vùng diện tích gradient bên dưới đường cong -->
                                            <Polygon Points="{Binding AreaChartPoints}" StrokeThickness="0">
                                                <Polygon.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#A7F3D0" Offset="0" />
                                                        <GradientStop Color="#FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Polygon.Fill>
                                            </Polygon>

                                            <!-- Đường Polyline chính -->
                                            <Polyline Points="{Binding LineChartPoints}" Stroke="#059669" StrokeThickness="3.5" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Border>

                                    <!-- Trục X: Các mốc nhãn giờ / ngày -->
                                    <Canvas Grid.Row="2" Grid.Column="1" Height="24" Width="760">
                                        <ItemsControl ItemsSource="{Binding ChartXTicks}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="2" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="-14,0,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>

                                    <!-- Tiêu đề Trục X -->
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ChartXAxisTitle}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- BIỂU ĐỒ CỘT (BAR CHART) DOANH THU THEO CA & TỪNG MỐC -->
                    <Border Background="#FFFFFF" CornerRadius="12" Padding="18" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊 BIỂU ĐỒ CỘT: CHI TIẾT DOANH THU THEO MỐC THỜI GIAN" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- 1. KHI XEM 24 GIỜ TRONG NGÀY: TÁCH RIÊNG 2 CA (SÁNG: 06h-17h & TỐI/ĐÊM: 18h-05h) KHÔNG BỊ TRÀN HÀNG -->
                            <StackPanel Visibility="{Binding Overview.IsHourlyView, Converter={StaticResource BoolToVisConverter}}">
                                <!-- KHUNG 1: CA SÁNG & CHIỀU (06:00 - 17:00) -->
                                <Border Background="#FFFDF7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="☀️ CA SÁNG &amp; CHIỀU (06:00 - 17:00)" FontSize="12" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center" />
                                                <Border Background="#FEF3C7" CornerRadius="6" Padding="8,2" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Overview.DayShiftRevenue, Converter={StaticResource CurrencyConverter}, StringFormat='Doanh thu: {0}'}" 
                                                               FontSize="11" FontWeight="Bold" Foreground="#92400E" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="12 Khung Giờ Ban Ngày (06h - 17h)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- 12 Cột Ca Sáng: Trải đều 100% chiều ngang -->
                                        <ItemsControl ItemsSource="{Binding Overview.DayShiftPoints}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="12" Height="130" VerticalAlignment="Bottom" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,0" VerticalAlignment="Bottom">
                                                        <!-- Số tiền trên đầu cột -->
                                                        <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}"
                                                                   FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <!-- Cột Màu Xanh Ngọc (Ca Sáng) -->
                                                        <Border Height="{Binding NormalizedHeight}" Background="#10B981" CornerRadius="3,3,0,0"
                                                                MinWidth="22" HorizontalAlignment="Center" ToolTip="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="3" Direction="270" Opacity="0.15" ShadowDepth="1" Color="#059669" />
                                                            </Border.Effect>
                                                        </Border>
                                                        <Rectangle Height="1.5" Fill="#CBD5E1" Margin="0,2,0,3" />
                                                        <!-- Mốc giờ -->
                                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- KHUNG 2: CA TỐI & ĐÊM (18:00 - 05:00 SÁNG) -->
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🌙 CA TỐI &amp; ĐÊM (18:00 - 05:00 SÁNG HÔM SAU)" FontSize="12" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                                                <Border Background="#E2E8F0" CornerRadius="6" Padding="8,2" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Overview.NightShiftRevenue, Converter={StaticResource CurrencyConverter}, StringFormat='Doanh thu: {0}'}" 
                                                               FontSize="11" FontWeight="Bold" Foreground="#0F172A" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="12 Khung Giờ Ban Đêm (18h - 05h)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- 12 Cột Ca Tối: Trải đều 100% chiều ngang -->
                                        <ItemsControl ItemsSource="{Binding Overview.NightShiftPoints}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="12" Height="130" VerticalAlignment="Bottom" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,0" VerticalAlignment="Bottom">
                                                        <!-- Số tiền trên đầu cột -->
                                                        <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}"
                                                                   FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Center" Margin="0,0,0,3" />
                                                        <!-- Cột Màu Xanh Dương (Ca Tối/Đêm) -->
                                                        <Border Height="{Binding NormalizedHeight}" Background="#0284C7" CornerRadius="3,3,0,0"
                                                                MinWidth="22" HorizontalAlignment="Center" ToolTip="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="3" Direction="270" Opacity="0.15" ShadowDepth="1" Color="#0369A1" />
                                                            </Border.Effect>
                                                        </Border>
                                                        <Rectangle Height="1.5" Fill="#CBD5E1" Margin="0,2,0,3" />
                                                        <!-- Mốc giờ -->
                                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 2. KHI XEM NHIỀU NGÀY (TUẦN NÀY, THÁNG NÀY, TÙY CHỌN): HIỂN THỊ CÁC NGÀY BÌNH THƯỜNG -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Visibility="{Binding Overview.IsHourlyView, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}">
                                <ItemsControl ItemsSource="{Binding Overview.ChartPoints}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="56" Margin="0,0,5,0" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}"
                                                           FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <Border Height="{Binding NormalizedHeight}" Background="#10B981" CornerRadius="4,4,0,0"
                                                        MinWidth="28" HorizontalAlignment="Center" ToolTip="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" Direction="270" Opacity="0.15" ShadowDepth="1" Color="#059669" />
                                                    </Border.Effect>
                                                </Border>
                                                <Rectangle Height="1" Fill="#CBD5E1" Margin="0,2,0,4" />
                                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- TAB 2: BÁO CÁO THEO TỪNG BÀN                             -->
            <!-- ======================================================== -->
            <Border Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=TABLES}"
                    Background="#FFFFFF" CornerRadius="12" Padding="18" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header & Bộ lọc bàn -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🎱 HIỆU SUẤT VÀ DOANH THU THEO TỪNG BÀN CHƠI" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Thống kê số lượt, thời gian chơi, tiền giờ và doanh thu dịch vụ từng bàn" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Bộ lọc theo khu vực và tìm kiếm bàn -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Khu vực:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding Areas}" DisplayMemberPath="AreaName" SelectedItem="{Binding SelectedArea, Mode=TwoWay}"
                                      Width="190" Height="34" Margin="0,0,12,0" />

                            <TextBlock Text="Tìm bàn:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Grid Width="160" Margin="0,0,8,0">
                                <TextBox x:Name="SearchTableInput" Text="{Binding TableSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" VerticalContentAlignment="Center" Padding="28,0,8,0" />
                                <TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" Foreground="#64748B" />
                                <TextBlock Text="Nhập tên bàn..." FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchTableInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchTableInput}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Content="✖ Xóa Lọc" Style="{StaticResource SecondaryButton}"
                                    Height="34" Padding="12,0" FontSize="11"
                                    Command="{Binding ResetTableFilterCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- KPI Cards Thống Kê Bàn -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TỔNG DOANH THU CÁC BÀN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalTablesRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TỔNG SỐ LƯỢT CHƠI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalTablesSessions, StringFormat='{}{0:N0} lượt'}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#F8FAFC" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="BÀN DOANH THU CAO NHẤT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding TopTableNumber}" FontSize="16" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Danh Sách Bàn DataGrid -->
                    <DataGrid Grid.Row="4" ItemsSource="{Binding TableReports}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                              BorderBrush="{StaticResource BorderDarkBrush}" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TÊN BÀN" Binding="{Binding TableNumber}" Width="110" FontWeight="Bold" />
                            <DataGridTextColumn Header="LOẠI BÀN" Binding="{Binding TableTypeName}" Width="120" />
                            <DataGridTextColumn Header="KHU VỰC" Binding="{Binding AreaName}" Width="120" />
                            <DataGridTextColumn Header="SỐ LƯỢT CHƠI" Binding="{Binding TotalSessions, StringFormat='{}{0} Lượt'}" Width="110" />
                            <DataGridTextColumn Header="THỜI GIAN CHƠI" Binding="{Binding PlayTimeFormatted}" Width="130" />
                            <DataGridTextColumn Header="TIỀN GIỜ" Binding="{Binding TimeRevenue, Converter={StaticResource CurrencyConverter}}" Width="120" />
                            <DataGridTextColumn Header="TIỀN MÓN F&amp;B" Binding="{Binding ServiceRevenue, Converter={StaticResource CurrencyConverter}}" Width="120" />
                            <DataGridTextColumn Header="TỔNG DOANH THU" Binding="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}" Width="140" FontWeight="Bold" />
                            
                            <DataGridTemplateColumn Header="ĐÁNH GIÁ HIỆU SUẤT" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="135" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{Binding RatingBadgeBg}" BorderBrush="{Binding RatingBadgeBorder}" 
                                                    BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding RatingBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding RatingBadgeFg}" />
                                            </Border>

                                            <ProgressBar Grid.Column="2" Value="{Binding RelativePercentage, Mode=OneWay}" Height="10" Maximum="100"
                                                         Foreground="{Binding RatingBarColor}" Background="#F1F5F9" BorderThickness="0" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- TAB 3: BÁO CÁO THEO MÓN ĂN / UỐNG (F&B)                  -->
            <!-- ======================================================== -->
            <Border Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=PRODUCTS}"
                    Background="#FFFFFF" CornerRadius="12" Padding="18" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header & Bộ lọc danh mục / tìm món -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🍔 BÁO CÁO &amp; XẾP HẠNG DOANH THU MÓN ĂN / UỐNG (F&amp;B)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Lọc chi tiết theo nhóm hàng F&amp;B hoặc gõ tên món để xem doanh thu, số lượng bán &amp; tỷ trọng" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Bộ Lọc Phân Loại Món & Tìm Kiếm -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Danh mục:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                      Width="200" Height="34" Margin="0,0,12,0" />

                            <TextBlock Text="Tìm món:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Grid Width="180" Margin="0,0,8,0">
                                <TextBox x:Name="SearchProductInput" Text="{Binding ProductSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" VerticalContentAlignment="Center" Padding="28,0,8,0" />
                                <TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" Foreground="#64748B" />
                                <TextBlock Text="Nhập tên / mã món..." FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchProductInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchProductInput}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Content="✖ Xóa Lọc" Style="{StaticResource SecondaryButton}"
                                    Height="34" Padding="12,0" FontSize="11"
                                    Command="{Binding ResetProductFilterCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- KPI Cards Thống Kê F&B -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Tổng Doanh Thu F&B -->
                        <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TỔNG DOANH THU F&amp;B" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalProductRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Tổng Số Lượng Bán -->
                        <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TỔNG SỐ LƯỢNG BÁN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalProductsSold, StringFormat='{}{0:N0} phần / lon'}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Số Mặt Hàng Phát Sinh Bán -->
                        <Border Grid.Column="4" Background="#F8FAFC" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SỐ MẶT HÀNG BÁN ĐƯỢC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding TotalProductItemsCount, StringFormat='{}{0} sản phẩm'}" FontSize="18" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Món Bán Chạy Nhất -->
                        <Border Grid.Column="6" Background="#F8FAFC" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MÓN BÁN CHẠY NHẤT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding BestSellingProductName}" FontSize="14" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Danh Sách Sản Phẩm DataGrid -->
                    <DataGrid Grid.Row="4" ItemsSource="{Binding ProductReports}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                              BorderBrush="{StaticResource BorderDarkBrush}" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TÊN SẢN PHẨM" Binding="{Binding ProductName}" Width="210" FontWeight="Bold" />
                            <DataGridTextColumn Header="NHÓM HÀNG" Binding="{Binding CategoryName}" Width="140" />
                            <DataGridTextColumn Header="ĐƠN GIÁ BÁN" Binding="{Binding SellingPrice, Converter={StaticResource CurrencyConverter}}" Width="120" />
                            <DataGridTextColumn Header="SỐ LƯỢNG BÁN" Binding="{Binding QuantitySold, StringFormat='{}x{0}'}" Width="130" FontWeight="Bold" />
                            <DataGridTextColumn Header="TỔNG DOANH THU" Binding="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}" Width="150" FontWeight="Bold" />
                            <DataGridTextColumn Header="TỶ TRỌNG" Binding="{Binding PercentageOfTotal, StringFormat='{}{0:F1}%'}" Width="110" />
                            
                            <!-- Cột Đánh Giá Mức Độ Tiêu Thụ / Bán Chạy -->
                            <DataGridTemplateColumn Header="ĐÁNH GIÁ TIÊU THỤ" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="135" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{Binding RatingBadgeBg}" BorderBrush="{Binding RatingBadgeBorder}" 
                                                    BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding RatingBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding RatingBadgeFg}" />
                                            </Border>

                                            <ProgressBar Grid.Column="2" Value="{Binding RelativePercentage, Mode=OneWay}" Height="10" Maximum="100"
                                                         Foreground="{Binding RatingBarColor}" Background="#F1F5F9" BorderThickness="0" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- TAB 4: SO SÁNH KỲ ĐỐI CHIẾU (TUẦN NÀY VS TUẦN TRƯỚC...) -->
            <!-- ======================================================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ActiveTab, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=COMPARISON}">
                <StackPanel>
                    <!-- Bộ chọn chế độ so sánh -->
                    <Border Background="#FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="CHỌN KỲ SO SÁNH ĐỐI CHIẾU:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                            <ComboBox Grid.Column="2" SelectedValue="{Binding SelectedComparisonMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag" Height="36" Background="#FFFFFF" Foreground="#000000" FontWeight="Bold">
                                <ComboBoxItem Content="📅 Tuần này so với Tuần trước" Tag="{x:Static dto:ComparisonPeriodMode.ThisWeekVsLastWeek}" IsSelected="True" />
                                <ComboBoxItem Content="📅 Tuần này so với 2 Tuần trước" Tag="{x:Static dto:ComparisonPeriodMode.ThisWeekVsTwoWeeksAgo}" />
                                <ComboBoxItem Content="📆 Tháng này so với Tháng trước" Tag="{x:Static dto:ComparisonPeriodMode.ThisMonthVsLastMonth}" />
                                <ComboBoxItem Content="⏱️ Hôm nay so với Hôm qua" Tag="{x:Static dto:ComparisonPeriodMode.TodayVsYesterday}" />
                            </ComboBox>

                            <!-- Nhãn thông tin kỳ đang so sánh -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ComparisonReport.CurrentPeriodLabel}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" />
                                <TextBlock Text="  SO VỚI  " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ComparisonReport.PreviousPeriodLabel}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Thẻ So Sánh Doanh Thu & Tăng Trưởng -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Thẻ Kỳ Này -->
                        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DOANH THU KỲ HIỆN TẠI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ComparisonReport.CurrentRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" Margin="0,4,0,8" />
                                
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Tiền giờ:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ComparisonReport.CurrentTimeRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Tiền món:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ComparisonReport.CurrentServiceRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Số hóa đơn:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ComparisonReport.CurrentInvoices, StringFormat='{}{0} HĐ'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Thẻ Kỳ Đối Chiếu (Trước Đó) -->
                        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DOANH THU KỲ ĐỐI CHIẾU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ComparisonReport.PreviousRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,8" />
                                
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Tiền giờ:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ComparisonReport.PreviousTimeRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Tiền món:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ComparisonReport.PreviousServiceRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Số hóa đơn:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ComparisonReport.PreviousInvoices, StringFormat='{}{0} HĐ'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Thẻ Tăng Trưởng (+/-) -->
                        <Border Grid.Column="4" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1.5" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="TĂNG TRƯỞNG &amp; CHÊNH LỆCH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" />
                                <TextBlock Text="{Binding ComparisonReport.RevenueDifference, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="Bold" Foreground="#047857" Margin="0,4,0,8" />
                                
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="Tỷ lệ tăng trưởng:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ComparisonReport.RevenueGrowthPercent, StringFormat='{}{0:+0.0;-0.0;0.0}%'}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#059669" />
                                    </Grid>
                                </Border>

                                <Grid>
                                    <TextBlock Text="Chênh lệch hóa đơn:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ComparisonReport.InvoicesDiff, StringFormat='{}{0:+0;-0;0} bill'}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- BIỂU ĐỒ CỘT KÉP SO SÁNH (SIDE-BY-SIDE BAR CHART) -->
                    <Border Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="📊 BIỂU ĐỒ CỘT KÉP SO SÁNH TRỰC QUAN GIỮA 2 KỲ" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Chú thích cột kỳ này -->
                                    <Border Width="12" Height="12" Background="#10B981" CornerRadius="3" Margin="0,0,4,0" />
                                    <TextBlock Text="Kỳ Này (Xanh)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />

                                    <!-- Chú thích cột kỳ trước -->
                                    <Border Width="12" Height="12" Background="#94A3B8" CornerRadius="3" Margin="0,0,4,0" />
                                    <TextBlock Text="Kỳ Đối Chiếu (Xám)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Khung Biểu Đồ Cột Kép Kèm Trục Tọa Độ X & Y -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="170" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Tiêu đề Trục Y -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="▲ Doanh thu" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,4" />

                                <!-- Trục Y: Thước đo giá trị VNĐ -->
                                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                    <!-- Max -->
                                    <TextBlock Text="{Binding ComparisonYMaxLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <!-- Mid -->
                                    <TextBlock Text="{Binding ComparisonYMidLabel}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <!-- 0 đ -->
                                    <TextBlock Text="{Binding ComparisonYZeroLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>

                                <!-- Vùng cột biểu đồ -->
                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1,0,0,1">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding ComparisonReport.ComparisonPoints}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="110" Margin="6,0" VerticalAlignment="Bottom">
                                                        <!-- Cặp 2 cột đứng cạnh nhau kèm số tiền trên đầu cột -->
                                                        <Grid Height="165" VerticalAlignment="Bottom">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Cột 1: Kỳ Này (Màu xanh ngọc kèm số tiền phía trên) -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                                                <TextBlock Text="{Binding ValueCurrentFormatted}" FontSize="9.5" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                                <Border Height="{Binding HeightCurrent}" Width="30" Background="#10B981" CornerRadius="4,4,0,0" HorizontalAlignment="Center"
                                                                        ToolTip="{Binding ValueCurrent, Converter={StaticResource CurrencyConverter}}" />
                                                            </StackPanel>

                                                            <!-- Cột 2: Kỳ Trước (Màu xám Slate kèm số tiền phía trên) -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                                                <TextBlock Text="{Binding ValuePreviousFormatted}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                                <Border Height="{Binding HeightPrevious}" Width="30" Background="#94A3B8" CornerRadius="4,4,0,0" HorizontalAlignment="Center"
                                                                        ToolTip="{Binding ValuePrevious, Converter={StaticResource CurrencyConverter}}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <Rectangle Height="1.5" Fill="#CBD5E1" Margin="0,2,0,4" />

                                                        <!-- Nhãn mốc thời gian -->
                                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <!-- Tiêu đề Trục X -->
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="▶ Mốc thời gian đối chiếu (Thứ trong tuần / Ngày trong kỳ)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
