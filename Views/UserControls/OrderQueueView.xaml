<UserControl x:Class="QL_JBillard.Views.UserControls.OrderQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100"
             Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER: BỘ LỌC & THỐNG KÊ -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Dòng 1: Tiêu đề & Các thẻ đếm trạng thái -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋 DANH SÁCH ORDER &amp; BẾP PHA CHẾ" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PendingCount, StringFormat='{}⏳ {0} món đang chờ'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" />
                        </Border>
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding OverdueCount, Converter={StaticResource IntToVisConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#DC2626" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OverdueCount, StringFormat='{}{0} món quá hạn 10p'}" FontSize="12" FontWeight="Bold" Foreground="#DC2626" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Content="🔄 Làm Mới Dữ Liệu" Style="{StaticResource SecondaryButton}"
                            Height="36" Padding="14,0" FontSize="12" FontWeight="SemiBold"
                            Command="{Binding RefreshCommand}" />
                </Grid>

                <!-- Dòng 2: Bộ lọc trạng thái, Bàn và Tìm kiếm -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Nút lọc trạng thái (Segmented Pills hiện đại, rõ nét) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton Content="⏳ Đang Chờ Phục Vụ" GroupName="OrderQueueFilters" Style="{StaticResource SegmentedTabRadioStyle}" 
                                     IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=PENDING}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="PENDING"
                                     Height="36" Padding="14,0" Margin="0,0,6,0" FontWeight="Bold" />

                        <RadioButton Content="📋 Tất Cả Món" GroupName="OrderQueueFilters" Style="{StaticResource SegmentedTabRadioStyle}" 
                                     IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ALL}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="ALL"
                                     Height="36" Padding="14,0" Margin="0,0,6,0" FontWeight="Bold" />

                        <RadioButton Content="✅ Đã Hoàn Thành" GroupName="OrderQueueFilters" Style="{StaticResource SegmentedTabRadioStyle}" 
                                     IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=COMPLETED}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="COMPLETED"
                                     Height="36" Padding="14,0" Margin="0,0,6,0" FontWeight="Bold" />

                        <RadioButton Content="❌ Đã Báo Hủy" GroupName="OrderQueueFilters" Style="{StaticResource SegmentedTabRadioStyle}" 
                                     IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=CANCELLED}"
                                     Command="{Binding SetFilterCommand}" CommandParameter="CANCELLED"
                                     Height="36" Padding="14,0" FontWeight="Bold" />
                    </StackPanel>

                    <!-- Lọc theo bàn -->
                    <ComboBox Grid.Column="2" ItemsSource="{Binding ActiveTableList}" SelectedItem="{Binding SelectedTableNumber}"
                              Height="36" Background="#FFFFFF" Foreground="#000000" FontWeight="SemiBold" FontSize="12" />

                    <!-- Ô Tìm kiếm món có HINT / WATERMARK rõ ràng -->
                    <Grid Grid.Column="4">
                        <TextBox x:Name="SearchOrderInput" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" VerticalContentAlignment="Center" Padding="32,0,10,0"
                                 Foreground="#000000" FontSize="12" />
                        <TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="#64748B" />
                        <TextBlock Text="Tìm tên món / bàn / mã order..." FontSize="12" Foreground="#94A3B8"
                                   VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchOrderInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchOrderInput}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- BODY: DANH SÁCH THẺ ORDER (SẮP XẾP FIFO: MÓN NÀO GỌI TRƯỚC LÊN TRƯỚC) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredOrders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="335" Margin="0,0,16,16" CornerRadius="12" Padding="14" BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Style.Triggers>
                                        <!-- Cảnh báo món trễ hơn 10 phút: Đổi viền đỏ và nền hồng nhạt -->
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="BorderBrush" Value="#EF4444" />
                                            <Setter Property="Background" Value="#FEF2F2" />
                                        </DataTrigger>
                                        <!-- Món đã hoàn thành: Viền xám mềm -->
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="Opacity" Value="0.75" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.06" ShadowDepth="2" Color="Black" />
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Dòng 1: Header thẻ - Tên Bàn & Bộ đếm thời gian chờ -->
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#10B981" CornerRadius="6" Padding="8,4">
                                            <TextBlock Text="{Binding TableNumber}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                        <TextBlock Text="{Binding AreaName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Bộ đếm thời gian thực & Badge cảnh báo trễ -->
                                    <Border HorizontalAlignment="Right" CornerRadius="6" Padding="8,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#ECFDF5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter Property="Background" Value="#DC2626" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⏱️ " FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding WaitTimeString}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentEmeraldDarkBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Rectangle Grid.Row="1" Fill="#F1F5F9" Height="1" Margin="0,4" />

                                <!-- Dòng 3: Thông tin món ăn & Số lượng -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ProductName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        
                                        <!-- Huy hiệu Món Thuộc Gói Combo -->
                                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,4,0,2" HorizontalAlignment="Left"
                                                Visibility="{Binding IsComboItem, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🎁 MÓN THEO COMBO: " FontSize="10" FontWeight="Bold" Foreground="#B45309" />
                                                <TextBlock Text="{Binding ComboName}" FontSize="10" FontWeight="Bold" Foreground="#92400E" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding OrderedAt, StringFormat='Gọi lúc: {0:HH:mm:ss}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Số lượng đặt -->
                                    <Border Grid.Column="1" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Quantity, StringFormat='{}x{0}'}" FontSize="16" FontWeight="Bold" Foreground="#4F46E5" />
                                    </Border>
                                </Grid>

                                <!-- Dòng 4: Đơn giá và Thành tiền -->
                                <Border Grid.Row="4" Background="#F8FAFC" Margin="-14,0" Padding="14,8">
                                    <Grid>
                                        <TextBlock Text="Tổng tiền món:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        
                                        <!-- Khi là món bán lẻ thông thường -->
                                        <TextBlock Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding IsComboItem, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}" />
                                        
                                        <!-- Khi là món tặng kèm theo gói combo -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                Visibility="{Binding IsComboItem, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="0 đ (Đã tính trong giá Combo)" FontSize="11" FontWeight="Bold" Foreground="#B45309" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Dòng 5: Các nút hành động (Hoàn thành / Báo hủy) -->
                                <Grid Grid.Row="6">
                                    <!-- Khi đang chờ: Hiện 2 nút Hoàn Thành và Báo Hủy -->
                                    <Grid Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisConverter}}">
                                        <Grid Visibility="{Binding IsCancelled, Converter={StaticResource InverseBoolToVisConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Nút Hoàn Thành (+ vào bill) -->
                                            <Button Grid.Column="0" Content="✓ HOÀN THÀNH" Style="{StaticResource PrimaryButton}"
                                                    Height="36" FontSize="12" FontWeight="Bold"
                                                    Command="{Binding DataContext.CompleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />

                                            <!-- Nút Báo Hủy (Trừ ra khỏi bill, hoàn kho) -->
                                            <Button Grid.Column="2" Content="✕ Báo Hủy" Style="{StaticResource DangerButton}"
                                                    Height="36" Padding="12,0" FontSize="12" FontWeight="SemiBold"
                                                    Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Grid>

                                    <!-- Trạng thái Đã Hoàn Thành -->
                                    <Border Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"
                                            Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                        <TextBlock Text="✓ ĐÃ PHỤC VỤ (ĐÃ TÍNH VÀO BILL)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" HorizontalAlignment="Center" />
                                    </Border>

                                    <!-- Trạng thái Đã Báo Hủy -->
                                    <Border Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVisConverter}}"
                                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                        <TextBlock Text="✕ ĐÃ BÁO HỦY (KHÔNG TÍNH TIỀN)" FontSize="11" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
