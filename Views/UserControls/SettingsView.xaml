<UserControl x:Class="QL_JBillard.Views.UserControls.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.3*" />
        </Grid.ColumnDefinitions>

        <!-- Cột Trái: Cấu Hình Thông Tin Quán & VietQR -->
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="CẤU HÌNH QUÁN &amp; NGÂN HÀNG VIETQR" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" Margin="0,0,0,16" />

                    <!-- Tên quán -->
                    <TextBlock Text="TÊN CÂU LẠC BỘ BIDA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ClubName, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12" />

                    <!-- Địa chỉ -->
                    <TextBlock Text="ĐỊA CHỈ QUÁN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ClubAddress, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12" />

                    <!-- Hotline -->
                    <TextBlock Text="SỐ ĐIỆN THOẠI HOTLINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ClubPhone, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,16" />

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="THÔNG TIN TÀI KHOẢN NHẬN TIỀN VIETQR" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12" />

                    <!-- Mã BIN ngân hàng -->
                    <TextBlock Text="MÃ BIN NGÂN HÀNG (VD: 970422 là MB, 970436 là VCB)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding BankBin, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12" />

                    <!-- Số tài khoản -->
                    <TextBlock Text="SỐ TÀI KHOẢN NGÂN HÀNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding BankAccountNo, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12" />

                    <!-- Tên chủ tài khoản -->
                    <TextBlock Text="TÊN CHỦ TÀI KHOẢN (KHÔNG DẤU)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding BankAccountName, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,16" />

                    <!-- Thông báo -->
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource AccentEmeraldDarkBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <Button Content="LƯU CẤU HÌNH HỆ THỐNG" Style="{StaticResource PrimaryButton}" Height="40" 
                            Command="{Binding SaveSettingsCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Cột Phải: Quản Lý Sao Lưu CSDL & Mã Hóa AES-256 -->
        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SAO LƯU CƠ SỞ DỮ LIỆU TỰ ĐỘNG &amp; MÃ HÓA" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" />
                            <TextBlock Text="Tự động sao lưu ghi đè và mã hóa AES-256 an toàn sau mỗi chu kỳ và sau thanh toán." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Content="⚡ Sao Lưu Ngay" Style="{StaticResource PrimaryButton}" Height="34" HorizontalAlignment="Right" 
                                Command="{Binding CreateBackupNowCommand}" />
                    </Grid>

                    <!-- Khung cài đặt tần suất sao lưu tự động -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="CÀI ĐẶT CHU KỲ TỰ ĐỘNG SAO LƯU" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Chu kỳ tự động ghi đè bản sao lưu an toàn khi ứng dụng đang mở" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding SelectedInterval}"
                                      DisplayMemberPath="DisplayName" Width="210" Height="36" Margin="10,0" Foreground="#000000" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Lưu Chu Kỳ" Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0" VerticalAlignment="Center"
                                    Command="{Binding SaveSettingsCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Bảng Lịch Sử Sao Lưu (Màu sáng) -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding BackupHistory}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True"
                          Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                          BorderBrush="{StaticResource BorderDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="150" />
                        <DataGridTextColumn Header="TÊN FILE SAO LƯU" Binding="{Binding BackupFileName}" Width="*" />
                        <DataGridTextColumn Header="DUNG LƯỢNG" Binding="{Binding FileSizeBytes, StringFormat='{}{0:N0} bytes'}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
