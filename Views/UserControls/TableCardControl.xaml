<UserControl x:Class="QL_JBillard.Views.UserControls.TableCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:QL_JBillard.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="285" d:DesignWidth="255">
    <Border Background="#FFFFFF" 
            BorderBrush="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
            BorderThickness="2" 
            CornerRadius="12" 
            Padding="14" 
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.08" ShadowDepth="3" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header: Tên bàn, Loại bàn, Badge Trạng thái -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding TableNumber}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding TableTypeName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                        CornerRadius="4" Padding="7,3" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}" 
                               FontSize="10" FontWeight="Bold" Foreground="White" />
                </Border>
            </Grid>

            <!-- 2. Body: Hiển thị theo trạng thái -->
            <Grid Grid.Row="1" VerticalAlignment="Center">
                <!-- Khi Bàn TRỐNG (Available) -->
                <StackPanel Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisConverter}}" 
                            HorizontalAlignment="Center" Margin="0,8">
                    <Border Width="42" Height="42" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Image Source="pack://application:,,,/Resources/app_icon.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="{Binding DefaultHourlyRate, Converter={StaticResource CurrencyConverter}, StringFormat='{}{0} / giờ'}" 
                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AreaName}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Khi Bàn ĐANG CÓ KHÁCH (Occupied) -->
                <StackPanel Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVisConverter}}">
                    <!-- Huy hiệu Combo nếu đang chơi gói combo -->
                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,4" HorizontalAlignment="Center"
                            Visibility="{Binding IsComboMode, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ComboBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#B45309" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Timer đếm thời gian thực dạng LED số lớn -->
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Margin="0,0,0,6" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCrimsonBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ElapsedTime, Converter={StaticResource TimeFormatConverter}}" 
                                       FontSize="20" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Khách hàng nếu có -->
                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="0,0,0,6" HorizontalAlignment="Center" BorderBrush="#BFDBFE" BorderThickness="1"
                            Visibility="{Binding CustomerName, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding CustomerName, StringFormat='👤 Khách: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" 
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Tạm tính tiền giờ & F&B -->
                    <Grid Margin="0,2">
                        <TextBlock Text="Tiền giờ chơi:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding EstimatedTimeCost, Converter={StaticResource CurrencyConverter}}" 
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,2">
                        <TextBlock Text="{Binding OrderCount, StringFormat='Dịch vụ ({0} món):'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ServiceCost, Converter={StaticResource CurrencyConverter}}" 
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,4" />

                    <Grid Margin="0,2">
                        <TextBlock Text="TỔNG TẠM TÍNH:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EstimatedTotalCost, Converter={StaticResource CurrencyConverter}}" 
                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- Khi Bàn BẢO TRÌ (Maintenance) -->
                <StackPanel Visibility="{Binding IsMaintenance, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center" Margin="0,15">
                    <TextBlock Text="🛠️" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Đang Bảo Trì / Lau Bi" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Tạm ngừng phục vụ khách" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Khi Bàn ĐÃ ĐẶT (Reserved) -->
                <StackPanel Visibility="{Binding IsReserved, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center" Margin="0,10">
                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="🔖" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="BÀN ĐÃ ĐƯỢC ĐẶT" FontSize="13" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center" />
                    <TextBlock Text="Sẵn sàng khi khách tới" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding DefaultHourlyRate, Converter={StaticResource CurrencyConverter}, StringFormat='{}{0} / giờ'}" 
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldDarkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- 3. Actions Footer -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <!-- Nút cho Bàn Trống: Mở bàn, Đặt bàn & Bảo trì -->
                <Grid Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="MỞ BÀN" Style="{StaticResource PrimaryButton}" Height="34" FontSize="12" FontWeight="Bold"
                            Command="{Binding DataContext.QuickOpenTableCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TableMapView}}}"
                            CommandParameter="{Binding}" />

                    <Button Grid.Column="2" Content="🔖 Đặt" Style="{StaticResource SecondaryButton}" Height="34" Padding="10,0" FontSize="11" FontWeight="SemiBold" ToolTip="Đánh dấu đã đặt bàn này"
                            Command="{Binding DataContext.ToggleReserveCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TableMapView}}}"
                            CommandParameter="{Binding}" />

                    <Button Grid.Column="4" Content="🛠️" Style="{StaticResource SecondaryButton}" Height="34" Width="36" Padding="0" ToolTip="Bảo trì bàn"
                            Command="{Binding DataContext.ToggleMaintenanceCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TableMapView}}}"
                            CommandParameter="{Binding}" />
                </Grid>

                <!-- Nút cho Bàn Đã Đặt: Mở bàn & Hủy đặt -->
                <Grid Visibility="{Binding IsReserved, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="MỞ BÀN" Style="{StaticResource PrimaryButton}" Height="34" FontSize="12" FontWeight="Bold"
                            Command="{Binding DataContext.QuickOpenTableCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TableMapView}}}"
                            CommandParameter="{Binding}" />

                    <Button Grid.Column="2" Content="Hủy Đặt" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" FontSize="11" FontWeight="SemiBold" ToolTip="Hủy đặt bàn (trả về bàn trống)"
                            Command="{Binding DataContext.ToggleReserveCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TableMapView}}}"
                            CommandParameter="{Binding}" />
                </Grid>

                <!-- Nút cho Bàn Đang Chơi: Gọi món, Đổi bàn, Thanh toán -->
                <Grid Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Gọi Món" Style="{StaticResource SecondaryButton}" Height="32" FontSize="11" Padding="2"
                            Command="{Binding DataContext.OrderCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TableMapView}}}"
                            CommandParameter="{Binding}" />

                    <Button Grid.Column="2" Content="Đổi Bàn" Style="{StaticResource SecondaryButton}" Height="32" FontSize="11" Padding="2"
                            Command="{Binding DataContext.SwitchTableCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TableMapView}}}"
                            CommandParameter="{Binding}" />

                    <Button Grid.Column="4" Content="THANH TOÁN" Style="{StaticResource DangerButton}" Height="32" FontSize="11" FontWeight="Bold" Padding="2"
                            Command="{Binding DataContext.CheckoutCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TableMapView}}}"
                            CommandParameter="{Binding}" />
                </Grid>

                <!-- Nút cho Bàn Bảo Trì: Mở lại bàn -->
                <Button Content="MỞ LẠI BÀN NÀY" Style="{StaticResource SecondaryButton}" Height="34" FontSize="11" FontWeight="SemiBold"
                        Visibility="{Binding IsMaintenance, Converter={StaticResource BoolToVisConverter}}"
                        Command="{Binding DataContext.ToggleMaintenanceCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TableMapView}}}"
                        CommandParameter="{Binding}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
