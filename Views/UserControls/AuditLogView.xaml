<UserControl x:Class="QL_JBillard.Views.UserControls.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Thanh Trạng Thái Bảo Mật Toàn Vẹn CSDL (Màu sáng) -->
        <Border Grid.Row="0" CornerRadius="10" Padding="18,14" Margin="0,0,0,18" BorderThickness="1.5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTampered}" Value="True">
                            <Setter Property="Background" Value="#FFF1F2" />
                            <Setter Property="BorderBrush" Value="#FECDD3" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ QUÉT PHÁT HIỆN HÀNH VI SỬA LÉN DỮ LIỆU (ANTI-TAMPERING)" 
                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding IntegrityStatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="🔍 Quét Hành Vi Sửa Lén" Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" FontWeight="Bold"
                        Command="{Binding VerifyDatabaseCommand}" />
            </Grid>
        </Border>

        <!-- 2. Danh Sách Nhật Ký Hệ Thống (Audit Logs) -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" Padding="18" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar Trên Cùng: Tiêu đề + Bộ Lọc Ngày + Nút Làm Mới Đầy Đặn Không Bị Che -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG VẬN HÀNH" 
                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Mở/đóng bàn, đổi bàn, gọi món, nộp tiền két, sửa tài khoản..." 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Bộ lọc theo ngày: Tất cả / Hôm nay / Hôm qua / 7 ngày qua -->
                    <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Padding="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Tất Cả" Style="{StaticResource SegmentedTabRadioStyle}" 
                                         IsChecked="{Binding SelectedDateFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ALL, Mode=OneWay}"
                                         Command="{Binding SetDateFilterCommand}" CommandParameter="ALL" />
                            <RadioButton Content="Hôm Nay" Style="{StaticResource SegmentedTabRadioStyle}" 
                                         IsChecked="{Binding SelectedDateFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=TODAY, Mode=OneWay}"
                                         Command="{Binding SetDateFilterCommand}" CommandParameter="TODAY" />
                            <RadioButton Content="Hôm Qua" Style="{StaticResource SegmentedTabRadioStyle}" 
                                         IsChecked="{Binding SelectedDateFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=YESTERDAY, Mode=OneWay}"
                                         Command="{Binding SetDateFilterCommand}" CommandParameter="YESTERDAY" />
                            <RadioButton Content="7 Ngày Qua" Style="{StaticResource SegmentedTabRadioStyle}" 
                                         IsChecked="{Binding SelectedDateFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=7DAYS, Mode=OneWay}"
                                         Command="{Binding SetDateFilterCommand}" CommandParameter="7DAYS" />
                        </StackPanel>
                    </Border>

                    <!-- Nút Xuất File CSV & Làm Mới Đầy Đặn, Rộng Rãi -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📥 Xuất File Nhật Ký (CSV)" Style="{StaticResource PrimaryButton}" 
                                Height="38" Padding="14,0" Margin="0,0,8,0" FontSize="12" FontWeight="Bold"
                                Command="{Binding ExportAuditLogsCommand}" />

                        <Button Content="🔄 Làm Mới Dữ Liệu" Style="{StaticResource SecondaryButton}" 
                                Height="38" Padding="14,0" FontSize="12" FontWeight="SemiBold"
                                Command="{Binding LoadLogsCommand}" />
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True"
                          Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                          BorderBrush="{StaticResource BorderDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding CreatedAtFormatted}" Width="160" />
                        <DataGridTextColumn Header="NGƯỜI THAO TÁC" Binding="{Binding OperatorName}" Width="150" FontWeight="SemiBold" />
                        
                        <!-- Cột Hành Động dạng Badge trực quan, phân màu rõ nghĩa -->
                        <DataGridTemplateColumn Header="HÀNH ĐỘNG" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ActionBadgeBackground}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ActionDisplay}" FontWeight="Bold" FontSize="11" Foreground="{Binding ActionBadgeForeground}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ĐỐI TƯỢNG" Binding="{Binding EntityNameDisplay}" Width="120" />
                        <DataGridTextColumn Header="CHI TIẾT DỮ LIỆU" Binding="{Binding DetailsDisplay}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
