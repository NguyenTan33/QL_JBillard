<Window x:Class="QL_JBillard.Views.Dialogs.BankDepositDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quản lý hệ thống bida - Nộp Tiền Ngân Hàng" 
        Icon="pack://application:,,,/Resources/bida.ico"
        Height="700" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    
    <Border Padding="22">
        <Border Background="#FFFFFF" CornerRadius="12" Padding="24" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.08" ShadowDepth="4" Color="Black" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="🏦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NỘP TIỀN VÀO TÀI KHOẢN NGÂN HÀNG" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" />
                            <TextBlock Text="Rút tiền mặt thực giữ trong két nộp lại cho chủ quán" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Khung thông tin tiền két hiện tại -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TIỀN THỰC GIỮ TRONG KÉT HIỆN CÓ:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding CurrentDrawerCash, Converter={StaticResource CurrencyConverter}}" 
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Nộp Toàn Bộ" Style="{StaticResource SecondaryButton}" Height="30" Padding="8,0" FontSize="11"
                                    Command="{Binding QuickFillMaxCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Số tiền nộp -->
                    <TextBlock Text="SỐ TIỀN NỘP NGÂN HÀNG (VNĐ) (*)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DepositAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource CurrencyConverter}}" 
                             Height="40" FontSize="17" FontWeight="Bold" Margin="0,0,0,12" 
                             Foreground="#000000" CaretBrush="#000000" Padding="10,0" VerticalContentAlignment="Center" />

                    <!-- Thông tin tài khoản thụ hưởng -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="TÀI KHOẢN NGÂN HÀNG NHẬN TIỀN (CLB):" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding BankName, StringFormat='Ngân hàng: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding BankAccountNo, StringFormat='Số tài khoản: {0}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding BankAccountName, StringFormat='Chủ tài khoản: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Chọn ảnh biên lai -->
                    <TextBlock Text="ẢNH CHỤP BIÊN LAI / BILL CHUYỂN TIỀN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ImagePath, Mode=OneWay}" IsReadOnly="True" 
                                 Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                 Foreground="#000000" FontSize="11" />
                        <Button Grid.Column="2" Content="📷 Chọn Ảnh..." Style="{StaticResource SecondaryButton}" 
                                Height="36" Command="{Binding SelectReceiptImageCommand}" />
                    </Grid>

                    <!-- Preview Ảnh nếu đã chọn -->
                    <Border Visibility="{Binding ImagePath, Converter={StaticResource BoolToVisConverter}}" 
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="140" Margin="0,0,0,12" ClipToBounds="True">
                        <Image Source="{Binding ImagePath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Ghi chú -->
                    <TextBlock Text="GHI CHÚ / NỘI DUNG NỘP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" Margin="0,0,0,14" 
                             Foreground="#000000" CaretBrush="#000000" Padding="8,4" />

                    <!-- Lỗi nếu có -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentCrimsonBrush}" 
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" 
                               Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}" />

                    <!-- Buttons -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy Bỏ" Style="{StaticResource SecondaryButton}" Height="40" Command="{Binding CancelCommand}" />
                        <Button Grid.Column="2" Content="✓ XÁC NHẬN NỘP TIỀN" Style="{StaticResource PrimaryButton}" Height="40" Command="{Binding ConfirmDepositCommand}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>
</Window>
