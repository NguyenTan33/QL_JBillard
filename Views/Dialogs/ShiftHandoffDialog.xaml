<Window x:Class="QL_JBillard.Views.Dialogs.ShiftHandoffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quản lý hệ thống bida - Xử Lý Bàn Đang Chơi Khi Chốt Ca"
        Icon="pack://application:,,,/Resources/bida.ico"
        Height="540" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">

    <Border Padding="20">
        <Border Background="#FFFFFF" CornerRadius="12" Padding="22" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Direction="270" Opacity="0.08" ShadowDepth="4" Color="Black" />
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="38" Height="38" CornerRadius="8" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CÒN BÀN ĐANG HOẠT ĐỘNG (CHƯA THANH TOÁN)" FontSize="14" FontWeight="Bold" Foreground="#DC2626" />
                            <TextBlock Text="Hệ thống phát hiện có bàn đang có khách chơi chưa được tính tiền" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Danh sách bàn đang mở -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0" MaxHeight="130">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ActiveTablesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="8,5" Background="#FFFFFF" CornerRadius="4" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TableNumber}" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding TableType.TypeName, StringFormat='({0})'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <TextBlock Grid.Column="2" Text="Đang có khách" Foreground="#D97706" FontWeight="SemiBold" FontSize="11" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- 2 Lựa Chọn Xử Lý -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,14">
                    <TextBlock Text="VUI LÒNG CHỌN HÌNH THỨC XỬ LÝ ĐỂ TIẾP TỤC CHỐT CA:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                    <!-- Lựa chọn 1: Chuyển tiếp ca sau -->
                    <Button Style="{StaticResource PrimaryButton}" Height="60" Margin="0,0,0,10" HorizontalContentAlignment="Left" Padding="14,0" Click="Handoff_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👉 LỰA CHỌN 1: CHUYỂN TIẾP CHO CA SAU QUẢN LÝ TIẾP" FontWeight="Bold" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="Các bàn tiếp tục tính giờ bình thường. Nhân viên ca sau sẽ nhận bàn giao và thu tiền." FontSize="11" Opacity="0.9" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Lựa chọn 2: Thanh toán tất cả trước -->
                    <Button Style="{StaticResource SecondaryButton}" Height="60" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="14,0" Click="CheckoutAll_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💳 LỰA CHỌN 2: THANH TOÁN TẤT CẢ CÁC BÀN TRƯỚC" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBlueBrush}" />
                            </StackPanel>
                            <TextBlock Text="Hủy chốt ca lúc này, quay về Sơ Đồ Bàn Chơi để thanh toán tất cả hóa đơn trước khi đóng ca." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer: Nút Hủy -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="✕ Hủy Bỏ (Không Chốt Ca)" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
