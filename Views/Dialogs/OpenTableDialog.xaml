<Window x:Class="QL_JBillard.Views.Dialogs.OpenTableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quản lý hệ thống bida - Mở Bàn Phục Vụ Khách"
        Icon="pack://application:,,,/Resources/bida.ico"
        Height="620" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,14" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎱 MỞ BÀN PHỤC VỤ - " FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding TableItem.TableNumber}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" />
                <TextBlock Text="{Binding TableItem.TableTypeName, StringFormat=' ({0})'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 2. Main Content Card -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Chọn Hình Thức Chơi -->
                    <TextBlock Text="HÌNH THỨC TÍNH TIỀN:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Option: Chơi Theo Giờ -->
                        <RadioButton Grid.Column="0" Content="⏱️ Chơi Theo Giờ" GroupName="OpenMode"
                                     IsChecked="{Binding IsHourlyMode, Mode=OneWay}"
                                     Command="{Binding SetModeCommand}" CommandParameter="HOURLY"
                                     Style="{StaticResource SegmentedTabRadioStyle}" Height="40" FontSize="13" FontWeight="Bold" />

                        <!-- Option: Gói Combo -->
                        <RadioButton Grid.Column="2" Content="🎁 Gói Combo F&amp;B" GroupName="OpenMode"
                                     IsChecked="{Binding IsComboMode, Mode=OneWay}"
                                     Command="{Binding SetModeCommand}" CommandParameter="COMBO"
                                     Style="{StaticResource SegmentedTabRadioStyle}" Height="40" FontSize="13" FontWeight="Bold" />
                    </Grid>

                    <!-- Khung chi tiết CHƠI THEO GIỜ -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding IsHourlyMode, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Đơn giá cơ sở loại bàn:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding TableItem.DefaultHourlyRate, Converter={StaticResource CurrencyConverter}, StringFormat='{}{0} / giờ'}" 
                                           FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="💡 Tự động áp dụng giá theo các Khung Giờ (Sáng, Chiều, Tối, Đêm) do quán đã cài đặt." 
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Khung chi tiết CHỌN GÓI COMBO -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding IsComboMode, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="CHỌN GÓI COMBO BIDA:" FontSize="11" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding AvailableCombos}" SelectedItem="{Binding SelectedCombo}" 
                                      DisplayMemberPath="ComboName" Height="36" Margin="0,0,0,10" />

                            <Border Background="#FFFFFF" CornerRadius="6" Padding="12" BorderBrush="#FDE68A" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Giá trọn gói:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedCombo.Price, Converter={StaticResource CurrencyConverter}}" 
                                                   FontSize="14" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Thời lượng miễn phí:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedCombo.DurationFormatted, StringFormat='{}{0} chơi bida'}" 
                                                   FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Ưu đãi F&amp;B đi kèm:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedCombo.IncludedItems}" 
                                                   FontSize="12" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedCombo.Description, StringFormat='Ghi chú: {0}'}" 
                                               FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Khách hàng & Hội viên -->
                    <TextBlock Text="KHÁCH HÀNG &amp; HỘI VIÊN (TÙY CHỌN):" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="13" />
                        <Button Grid.Column="2" Content="Tra cứu" Style="{StaticResource SecondaryButton}" Height="34" Command="{Binding SearchCustomerCommand}" />
                    </Grid>

                    <Border Background="#EFF6FF" CornerRadius="6" Padding="8,4" Margin="0,0,0,10" BorderBrush="#BFDBFE" BorderThickness="1"
                            Visibility="{Binding Customer, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding Customer.FullName, StringFormat='👤 Thành viên: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" />
                    </Border>

                    <!-- Ghi chú mở bàn -->
                    <TextBlock Text="GHI CHÚ / LƯU Ý MỞ BÀN:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" />

                    <!-- Thông báo lỗi nếu có -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentCrimsonBrush}" FontSize="12" FontWeight="SemiBold" 
                               Margin="0,0,0,6" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource SmartVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 3. Actions Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Hủy (Esc)" Style="{StaticResource SecondaryButton}" Height="40" Command="{Binding CancelCommand}" />
            
            <Button Grid.Column="2" Content="MỞ BÀN (ENTER)" Style="{StaticResource PrimaryButton}" Height="40" Padding="22,0" FontSize="13" FontWeight="Bold"
                    Command="{Binding ConfirmOpenCommand}">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.2" ShadowDepth="2" Color="#059669" />
                </Button.Effect>
            </Button>
        </Grid>
    </Grid>
</Window>
