<Window x:Class="QL_JBillard.Views.Dialogs.OrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quản lý hệ thống bida - Thực Đơn &amp; Gọi Món Nhanh" 
        Icon="pack://application:,,,/Resources/bida.ico"
        Height="820" Width="1280"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDarkBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header: Chuyển nhanh giữa các bàn đang mở -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MENU GỌI MÓN - " FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                    <!-- COMBOBOX CHUYỂN BÀN GỌI MÓN NHANH -->
                    <ComboBox ItemsSource="{Binding ActiveTables}" 
                              SelectedItem="{Binding SelectedActiveTable}"
                              Width="270" Height="38" FontSize="15" FontWeight="Bold"
                              Foreground="#000000" VerticalContentAlignment="Center" Margin="8,0,14,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TableNumber}" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" FontSize="15" />
                                    <TextBlock Text="{Binding TableTypeName, StringFormat=' - {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AreaName, StringFormat=' ({0})'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="⚡ Chọn bàn trực tiếp để order liên tục cho các bàn đang mở mà không cần đóng popup" 
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldDarkBrush}" />
                    </Border>
                </StackPanel>

                <!-- Nút Đóng -->
                <Button Grid.Column="1" Content="✕ Đóng Cửa Sổ" Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" Click="Close_Click" />
            </Grid>
        </Border>

        <!-- 2. Main Body: Chia đôi Thực Đơn (Trái) và Giỏ Gọi (Phải) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cột Trái: Danh Sách Món Có Ảnh & Bộ Lọc -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Lọc danh mục & Tìm kiếm -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>

                        <!-- Ô tìm kiếm -->
                        <Grid Grid.Column="0">
                            <TextBox x:Name="TxtSearch" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="38" Padding="10,0" VerticalContentAlignment="Center" FontSize="13" 
                                     Foreground="#000000" CaretBrush="#000000" FontWeight="SemiBold" />
                            <TextBlock Text="🔍 Tìm kiếm món theo tên hoặc mã món..." Foreground="{StaticResource TextMutedBrush}" 
                                       Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding SearchKeyword, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}" />
                        </Grid>

                        <!-- Dropdown Danh mục -->
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" 
                                  DisplayMemberPath="CategoryName" Height="38" />
                    </Grid>

                    <!-- Grid Sản Phẩm Lớn Có Ảnh / Hình Minh Họa Sinh Động -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" CornerRadius="10" Margin="6" Width="200" Height="225" 
                                            BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="95" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 1. Vùng Ảnh Món Ăn / Thumbnail Minh Họa -->
                                            <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True" Background="#F1F5F9">
                                                <Grid>
                                                    <!-- Ảnh nếu có -->
                                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding ImagePath, Converter={StaticResource BoolToVisConverter}}" />

                                                    <!-- Fallback hình minh họa theo nhóm danh mục nếu chưa có file ảnh -->
                                                    <Border Visibility="{Binding ImagePath, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}"
                                                            Background="#F8FAFC">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock FontSize="34" HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="🍽️" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Category.CategoryName}" Value="Đồ Uống Lon &amp; Chai">
                                                                                <Setter Property="Text" Value="🥤" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Category.CategoryName}" Value="Cà Phê &amp; Pha Chế">
                                                                                <Setter Property="Text" Value="☕" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Category.CategoryName}" Value="Bia &amp; Cồn">
                                                                                <Setter Property="Text" Value="🍺" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Category.CategoryName}" Value="Đồ Ăn Nhanh Chế Biến">
                                                                                <Setter Property="Text" Value="🍜" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Category.CategoryName}" Value="Phụ Kiện Bida">
                                                                                <Setter Property="Text" Value="🎱" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Category.CategoryName}" FontSize="10" FontWeight="SemiBold" 
                                                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- 2. Thông tin tên món, giá tiền, tồn kho -->
                                            <StackPanel Grid.Row="1" Margin="10,8,10,4">
                                                <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="Bold" 
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                                
                                                <Grid Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding SellingPrice, Converter={StaticResource CurrencyConverter}}" 
                                                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" />
                                                    <TextBlock Text="{Binding InventoryItem.QuantityOnHand, StringFormat='Kho: {0}'}" 
                                                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"
                                                               Visibility="{Binding IsInventoryItem, Converter={StaticResource BoolToVisConverter}}" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- 3. Nút Thêm vào giỏ -->
                                            <Button Grid.Row="2" Content="+ Thêm Vào Giỏ" Style="{StaticResource PrimaryButton}" 
                                                    Height="32" Margin="10,0,10,10" FontSize="12" FontWeight="Bold"
                                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Cột Phải: Giỏ Món Đang Chọn & Món Đã Phục Vụ -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.05" ShadowDepth="2" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding TableItem.TableNumber, StringFormat='MÓN VỪA CHỌN GỌI CHO {0}:'}" 
                                   FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" />
                        <TextBlock Text="{Binding CartItems.Count, StringFormat='{}{0} món'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- List Giỏ Hàng Mới -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding CartItems}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Product.ProductName}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" />
                                        </StackPanel>

                                        <!-- Tăng giảm số lượng -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="-" Style="{StaticResource SecondaryButton}" Width="26" Height="26" Padding="0" 
                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Quantity}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <Button Content="+" Style="{StaticResource SecondaryButton}" Width="26" Height="26" Padding="0" 
                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="{StaticResource AccentCrimsonBrush}" BorderThickness="0" Margin="6,0,0,0" Cursor="Hand" FontWeight="Bold"
                                                Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Món Đã Phục Vụ Trước Đó -->
                    <TextBlock Grid.Row="2" Text="MÓN ĐÃ PHỤC VỤ TRƯỚC ĐÓ:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,6" />
                    
                    <ListBox Grid.Row="3" ItemsSource="{Binding ExistingOrderItems}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Product.ProductName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                    <Button Grid.Column="2" Content="Hủy" Style="{StaticResource DangerButton}" Height="22" Padding="6,0" FontSize="10"
                                            Command="{Binding DataContext.CancelOrderItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Tổng Cộng & Nút Xác Nhận -->
                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,8" />
                        
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="CỘNG THÊM GIỎ HÀNG:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CartTotal, Converter={StaticResource CurrencyConverter}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldDarkBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource AccentEmeraldDarkBrush}" 
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="✓ Gọi Món" Style="{StaticResource SecondaryButton}" Height="40" FontSize="12" FontWeight="Bold"
                                    Command="{Binding ConfirmOrderCommand}" />
                            <Button Grid.Column="2" Content="✓ GỌI &amp; ĐÓNG" Style="{StaticResource PrimaryButton}" Height="40" FontSize="12" FontWeight="Bold"
                                    Command="{Binding ConfirmAndCloseCommand}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
